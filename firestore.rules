rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidTransaction(data) {
      return data.keys().hasAll(['targetUsername', 'coins', 'usdRate', 'totalUsd', 'status', 'createdAt']) &&
             data.keys().hasOnly(['targetUsername', 'coins', 'usdRate', 'totalUsd', 'senderName', 'status', 'note', 'createdAt']) &&
             data.targetUsername is string && data.targetUsername.size() > 0 && data.targetUsername.size() <= 60 &&
             data.coins is number && data.coins > 0 &&
             data.usdRate is number && data.usdRate > 0 &&
             data.totalUsd is number && data.totalUsd >= 0 &&
             data.status in ['completed', 'pending', 'cancelled'] &&
             data.createdAt is string && data.createdAt.size() <= 60 &&
             (!('senderName' in data) || (data.senderName is string && data.senderName.size() <= 60)) &&
             (!('note' in data) || (data.note is string && data.note.size() <= 200));
    }

    match /transactions/{transactionId} {
      allow read: if isValidId(transactionId);
      allow create: if isValidId(transactionId) && isValidTransaction(incoming());
      allow update: if isValidId(transactionId) && isValidTransaction(incoming());
      allow delete: if isValidId(transactionId);
    }

    match /settings/{settingId} {
      allow read: if isValidId(settingId);
      allow write: if isValidId(settingId);
    }
  }
}
